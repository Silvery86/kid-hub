# =============================================================================
# Kid Hub — Mobile app (apps/mobile) environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` (git-ignored) and fill in real values:
#     cp apps/mobile/.env.example apps/mobile/.env.local
# Only EXPO_PUBLIC_* vars are exposed to the app bundle — never put secrets here.
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────

# Base URL of the web REST API, INCLUDING the /api/v1 prefix. The axios client
# (src/api/client.ts) uses this as its baseURL. In local dev use your machine's
# LAN IP (not localhost) so a physical device/emulator can reach the web app:
#     e.g. http://192.168.1.50:3000/api/v1
EXPO_PUBLIC_API_URL="http://192.168.1.x:3000/api/v1"

# ── Optional ─────────────────────────────────────────────────────────────────

# Origin used to resolve heavy game media (flashcards) served from the web
# app's /public. If unset it is derived by stripping /api/v1 from
# EXPO_PUBLIC_API_URL (see src/lib/web-origin.ts). Set explicitly to point at a
# CDN — this is the single place that changes for a CDN migration.
EXPO_PUBLIC_WEB_ORIGIN=""
