// ============================================================
// Kid Hub — Prisma Schema
// Source of truth for all database models.
// All types here must align with types/index.ts.
//
// Connection URLs are configured in prisma.config.ts (Prisma v7).
//
// After editing:
//   npx prisma migrate dev --name <description>
//   npx prisma generate
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ── Accounts ──────────────────────────────────────────────────
// Parent = who signs in. Student = whose data it is. They were one `User`
// row until the 20260829 split; keeping them separate is what makes more
// than one household possible. A parent reaches a student ONLY through a
// ParentStudent row — that join is the authorization edge.

/// Signup is open, but a new parent lands in PENDING and cannot obtain a
/// session until an admin moves them to ACTIVE. SUSPENDED is the reversible
/// off-switch for an account that was previously approved.
enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model Parent {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  displayName      String?
  loginAttempts    Int       @default(0)
  loginLockedUntil DateTime?

  status        AccountStatus @default(PENDING)
  isAdmin       Boolean       @default(false)
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    Parent?       @relation("ParentApproval", fields: [approvedById], references: [id], onDelete: SetNull)
  approved      Parent[]      @relation("ParentApproval")
  reviewNote    String?       @db.VarChar(200) // shown to the applicant on rejection
  signupPayload Json? // first student's name/grade, held until approval

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pin           ParentPin?
  refreshTokens RefreshToken[]
  students      ParentStudent[]
  notifications ActivityEvent[]
  invitesSent   StudentInvite[]

  @@index([status])
  @@map("parents")
}

model Student {
  id                    String    @id @default(cuid())
  name                  String
  gradeLevel            Int       @default(1)
  avatarUrl             String?
  /// Class identity as the printed thời khóa biểu heads it: "1A1",
  /// GVCN and their number. All optional — a household that never fills
  /// them in simply sees no header.
  className             String?   @db.VarChar(20)
  teacherName           String?   @db.VarChar(80)
  teacherPhone          String?   @db.VarChar(20)
  kidPatternHash        String?
  kidPatternAttempts    Int       @default(0)
  kidPatternLockedUntil DateTime?
  kidAccessSettings     Json? // Record<string, boolean> — feature toggle state; null = all defaults
  screenTimeLimitMins   Int       @default(120) // daily screen time limit set by parent
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  parents             ParentStudent[]
  invites             StudentInvite[]
  periods             ClassPeriod[]
  bellSchedule        BellSchedule?
  schoolBreaks        SchoolBreak[]
  grades              SubjectGrade[]
  progress            UserProgress?
  mathProgress        MathProgress[]
  englishProgress     EnglishProgress[]
  dailyHomework       DailyHomework[]
  extraClassOverrides ExtraClassOverride[]
  screenTimeLogs      ScreenTimeLog[]
  activityEvents      ActivityEvent[]

  @@map("students")
}

/// OWNER created the student; GUARDIAN was invited to it. Not enforced yet —
/// both roles have identical permissions until a later project says otherwise.
enum ParentRole {
  OWNER
  GUARDIAN
}

/// The authorization edge: a parent may read or write a student's data if and
/// only if a row exists here.
model ParentStudent {
  id        String     @id @default(cuid())
  parentId  String
  parent    Parent     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role      ParentRole @default(OWNER)
  createdAt DateTime   @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
  @@map("parent_students")
}

/// One row per signed-in device. Replaces the single users.refreshTokenHash
/// column, which silently signed out the first device when a second signed in.
model RefreshToken {
  id          String    @id @default(cuid())
  parentId    String
  parent      Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  tokenHash   String
  deviceLabel String?   @db.VarChar(60) // "iPhone", "Chrome on Windows"
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?

  @@index([parentId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Second-parent invite: one parent invites another to an existing student.
model StudentInvite {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   Parent    @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  codeHash    String // hash of the code — the raw code is never stored
  email       String? // optional: restrict redemption to one address
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedBy  String?
  createdAt   DateTime  @default(now())

  @@index([studentId])
  @@map("student_invites")
}

// ── Parent Auth ───────────────────────────────────────────────

model ParentPin {
  id          String    @id @default(cuid())
  hash        String // argon2id hash — raw PIN never stored
  parentId    String    @unique
  parent      Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  attempts    Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("parent_pins")
}

// ── Schedule ──────────────────────────────────────────────────

/// Day of week matches DayOfWeek type in types/index.ts
enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

/// A slot in the school's daily bell schedule. PERIOD is a numbered tiết and the
/// only kind that accepts a subject; BREAK is ra chơi; ROUTINE is everything else
/// the day contains — arrival, ăn trưa & ngủ, the guided hour.
enum SlotKind {
  PERIOD
  BREAK
  ROUTINE
}

/// The bell rules a school publishes, kept so the timeline can be regenerated
/// when a parent corrects one of them. Routines are not stored here: they are
/// authored directly as ROUTINE slots, since nothing derives them.
model BellSchedule {
  id                     String   @id @default(cuid())
  studentId              String   @unique
  student                Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  presetKey              String?  @db.VarChar(40)
  periodMinutes          Int      @default(35)
  transitionMinutes      Int      @default(5)
  morningStart           String   @db.VarChar(5)
  morningPeriods         Int      @default(4)
  morningRecessAfter     Int?
  morningRecessStart     String?  @db.VarChar(5)
  morningRecessMinutes   Int?
  afternoonStart         String?  @db.VarChar(5)
  afternoonPeriods       Int      @default(0)
  afternoonRecessAfter   Int?
  afternoonRecessStart   String?  @db.VarChar(5)
  afternoonRecessMinutes Int?
  /// Bán trú — the child stays over midday. Decides whether the lunch/nap block
  /// is derived at all, and which dismissal time the parent is shown.
  boarding               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  slots BellSlot[]

  @@map("bell_schedules")
}

/// One row of the day timeline. `days` carries the per-weekday variation —
/// Friday omits the guided hour — so no weekday needs special-casing in code.
model BellSlot {
  id           String       @id @default(cuid())
  scheduleId   String
  schedule     BellSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  kind         SlotKind
  periodNumber Int? // set only when kind = PERIOD
  label        String?      @db.VarChar(40)
  startTime    String       @db.VarChar(5)
  endTime      String       @db.VarChar(5)
  days         DayOfWeek[]
  /// False once a parent hand-edits the slot, so regenerating will not clobber it.
  isGenerated  Boolean      @default(true)

  @@index([scheduleId])
  @@map("bell_slots")
}

/// EventType distinguishes recurring school classes from recurring extra classes.
enum EventType {
  SCHOOL_PERIOD
  EXTRA_CLASS
}

model ClassPeriod {
  id              String    @id @default(cuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  day             DayOfWeek
  periodNumber    Int? // 1–10 for SCHOOL_PERIOD; null for EXTRA_CLASS
  /// Monday of the week this row belongs to, "YYYY-MM-DD". Set on every
  /// SCHOOL_PERIOD row and NULL on every EXTRA_CLASS one — an evening class is
  /// a standing arrangement, a school week is a dated record. A CHECK
  /// constraint added in 20260913000000 enforces that correspondence, which the
  /// PSL cannot express. See docs/SCHEDULE_PARENT_IMP.md §12.5.
  weekStartDate   String?   @db.VarChar(10)
  /// How far this week's timetable reaches.
  ///
  /// false — STANDING: this is the timetable from this week onwards, and any
  ///   later week without rows of its own shows it. The seeded week is standing,
  ///   so it acts as the default.
  /// true — EXCEPTION: a one-week change (a test, a school event). It is shown
  ///   for its own week and never inherited by a later one.
  ///
  /// Was absent before 20260916: every saved week became the new source of
  /// inheritance, so editing one week silently rewrote every later week.
  isWeekException Boolean   @default(false)
  eventType       EventType @default(SCHOOL_PERIOD)
  subjectId       String // References SUBJECTS constant in lib/data/subjects.ts
  note            String?   @db.VarChar(40) // lesson variant, e.g. "Học vần", "Tập viết"
  startTime       String // "HH:MM" 24-hour format
  endTime         String // "HH:MM" 24-hour format
  roomNumber      String?
  iconKey         String?   @db.VarChar(30) // e.g. "english", "music", "backpack"
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  overrides ExtraClassOverride[]

  // Unique slot per school period *per week*. Postgres counts NULLs as
  // distinct, which would weaken this — except that the only rows with a NULL
  // weekStartDate are extra classes, whose periodNumber is NULL too, so they
  // were never covered by this index in the first place.
  @@unique([studentId, weekStartDate, day, periodNumber])
  @@index([studentId, weekStartDate])
  @@index([studentId, day])
  @@index([studentId, eventType])
  @@map("class_periods")
}

// ── School breaks ─────────────────────────────────────────────

/// Why the timetable does not run. PUBLIC_HOLIDAY is a day off — Tết, 30/4,
/// or one the school declares. SUMMER_BREAK is nghỉ hè: the 2–3 months between
/// one grade and the next, declared by the parent when the school announces it.
/// Summer classes and summer homework continue through it, which is why both
/// kinds suppress SCHOOL_PERIOD rows and nothing else.
enum SchoolBreakKind {
  PUBLIC_HOLIDAY
  SUMMER_BREAK
}

model SchoolBreak {
  id              String          @id @default(cuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind            SchoolBreakKind @default(PUBLIC_HOLIDAY)
  label           String          @db.VarChar(60)
  /// Inclusive "YYYY-MM-DD". A one-day holiday has startDate == endDate.
  startDate       String          @db.VarChar(10)
  endDate         String          @db.VarChar(10)
  /// Set when the row came from the shipped Vietnamese list, so a re-seed can
  /// recognise what it created and leave a parent's edits alone.
  presetKey       String?         @db.VarChar(40)
  /// True for a lunar-derived default (Tết, Giỗ Tổ) whose real dates the school
  /// announces. Surfaced as "kiểm tra lại ngày" rather than passed off as fact.
  needsReview     Boolean         @default(false)
  /// SUMMER_BREAK only — the grade the child returns to. Storable as the SAME
  /// grade on purpose: a child repeating a year still has a summer.
  promotesToGrade Int?
  /// When the parent confirmed the promotion. A clock never sets this.
  promotedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // One row per shipped holiday per student; parent-added rows have a NULL
  // presetKey and are therefore unconstrained, which is correct — a family may
  // legitimately add two separate breaks with the same name in different years.
  @@unique([studentId, presetKey])
  @@index([studentId, startDate])
  @@map("school_breaks")
}

// ── Homework ──────────────────────────────────────────────────

/// One-off homework assignment for a specific date. Not recurring.
model DailyHomework {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String    @db.VarChar(10) // "YYYY-MM-DD"
  subjectId String    @db.VarChar(30)
  label     String    @db.VarChar(150)
  iconKey   String?   @db.VarChar(30)
  isDone    Boolean   @default(false)
  doneAt    DateTime?
  points    Int       @default(10)
  createdAt DateTime  @default(now())

  @@index([studentId, date])
  @@map("daily_homework")
}

/// Per-date cancellation of a recurring EXTRA_CLASS slot.
model ExtraClassOverride {
  id        String      @id @default(cuid())
  periodId  String
  period    ClassPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String      @db.VarChar(10) // "YYYY-MM-DD" of the cancellation
  reason    String?     @db.VarChar(100)
  createdAt DateTime    @default(now())

  @@unique([periodId, date])
  @@index([studentId, date])
  @@map("extra_class_overrides")
}

// ── Grades ────────────────────────────────────────────────────

/// BadgeTier matches BadgeTier type in types/index.ts
enum BadgeTier {
  excellent
  good
  needs_practice @map("needs-practice")
}

model SubjectGrade {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String // References SUBJECTS constant
  score        Float // 0–10 scale
  badge        BadgeTier
  semester     Int // 1 or 2
  academicYear String // e.g. "2025-2026"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // One grade per subject per semester per year
  @@unique([studentId, subjectId, semester, academicYear])
  @@index([studentId])
  @@map("subject_grades")
}

// ── Gamification ──────────────────────────────────────────────

model UserProgress {
  id             String   @id @default(cuid())
  studentId      String   @unique
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalPoints    Int      @default(0)
  currentStreak  Int      @default(0)
  lastActiveDate String // ISO date "YYYY-MM-DD"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  earnedBadges EarnedBadge[]
  bestScores   GameBestScore[]

  @@map("user_progress")
}

model EarnedBadge {
  id             String       @id @default(cuid())
  userProgressId String
  userProgress   UserProgress @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  badgeId        String // Static badge ID from lib/data
  earnedAt       DateTime     @default(now())

  @@unique([userProgressId, badgeId])
  @@map("earned_badges")
}

/// GameType matches GameType in types/index.ts
enum GameType {
  math
  english
}

/// MathGameType distinguishes the three math mini-games within the math route.
enum MathGameType {
  counting
  addition
  shapes
}

/// EnglishGameType distinguishes the three English mini-games within the english route.
enum EnglishGameType {
  alphabet
  vocabulary
  phonics
}

model GameBestScore {
  id             String       @id @default(cuid())
  userProgressId String
  userProgress   UserProgress @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  gameType       GameType
  level          Int // 1, 2, or 3 — maps to DifficultyLevel
  score          Int
  starsEarned    Int // 1, 2, or 3
  subType        String? // "counting" | "addition" | "shapes" for math; "alphabet" | "vocabulary" | "phonics" for english
  achievedAt     DateTime     @default(now())

  // One best score per game + level + subType (subType differentiates math mini-games)
  @@unique([userProgressId, gameType, level, subType])
  @@map("game_best_scores")
}

// ── Math Progress ─────────────────────────────────────────────

/// Records a single completed math mini-game session.
model MathProgress {
  id               String       @id @default(cuid())
  studentId        String
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  minigame         MathGameType
  level            Int // 1, 2, or 3
  correctCount     Int
  incorrectCount   Int
  timeSpentSecs    Int // Total wall-clock seconds for the session
  starsEarned      Int // 1–3
  score            Int // correctCount × 10 × starsEarned
  homeworkPeriodId String? // FK to ClassPeriod — set when submitted as homework
  homeworkDate     String? // "YYYY-MM-DD" — the homework date it was submitted for
  completedAt      DateTime     @default(now())

  @@index([studentId, completedAt])
  @@index([studentId, homeworkPeriodId])
  @@map("math_progress")
}

// ── English Progress ──────────────────────────────────────────

/// Records a single completed English mini-game session.
model EnglishProgress {
  id               String          @id @default(cuid())
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  minigame         EnglishGameType // alphabet | vocabulary | phonics
  level            Int // 1, 2, or 3
  correctCount     Int
  incorrectCount   Int
  timeSpentSecs    Int // Total wall-clock seconds for the session
  starsEarned      Int // 1–3, derived from correctCount / totalQuestions
  score            Int // correctCount × 10 × starsEarned
  homeworkPeriodId String? // FK to ClassPeriod — set when submitted as homework
  homeworkDate     String? // "YYYY-MM-DD" — required if homeworkPeriodId set
  completedAt      DateTime        @default(now())

  @@index([studentId, completedAt])
  @@index([studentId, homeworkPeriodId])
  @@map("english_progress")
}

// ── Screen Time ───────────────────────────────────────────────

/// Accumulates total screen time per kid per day in seconds. One record per (studentId, date).
model ScreenTimeLog {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String   @db.VarChar(10) // "YYYY-MM-DD"
  totalSecs Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([studentId])
  @@map("screen_time_logs")
}

// ── Activity Feed ─────────────────────────────────────────────

/// Records a significant kid-side event for the parent activity feed.
/// Records a significant event. Two roles in one table, distinguished by
/// `parentId`: a NULL recipient is a log-only row for the activity feed, a set
/// one is also a notification in that parent's inbox.
///
/// `parentId` is a ROUTING field, never an authorisation one. The read path
/// joins parent_students so a revoked co-parent immediately stops seeing rows
/// about a child they no longer have access to — a denormalised column cannot
/// answer "may they touch this student" any more than a token can.
model ActivityEvent {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Recipient. NULL = log-only, no inbox entry.
  parentId  String?
  parent    Parent?   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(30) // GAME_COMPLETE | HOMEWORK_DONE | BADGE_EARNED | ...
  label     String    @db.VarChar(150) // human-readable description shown to parent
  iconKey   String?   @db.VarChar(10) // emoji displayed in the feed
  /// Where tapping it goes. Keeps routing out of the component.
  href      String?   @db.VarChar(120)
  readAt    DateTime?
  /// Stops the same moment arriving twice, e.g. "badge:streak-3:<studentId>".
  /// NULLs are distinct in Postgres, so log-only rows are unaffected.
  dedupeKey String?   @db.VarChar(80)

  createdAt DateTime @default(now())

  @@unique([parentId, dedupeKey])
  @@index([parentId, readAt, createdAt])
  @@index([studentId, createdAt])
  @@map("activity_events")
}
