# =============================================================================
# Kid Hub — Web app (apps/web) environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` (git-ignored) and fill in real values:
#     cp apps/web/.env.example apps/web/.env.local
# Never commit real secrets — only this template is tracked.
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string used at runtime (pooled connection).
# The app throws on first query if this is unset (see lib/db.ts).
DATABASE_URL="postgresql://user:password@host:5432/kidhub?sslmode=require"

# Symmetric secret for signing all JWTs (parent access/refresh + kid session).
# MUST be at least 32 characters — the app throws at boot if it is missing or
# too short (see server/services/auth.service.ts). Generate a strong random one:
#     openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"

# ── Recommended (auth/rate-limit hardening) ──────────────────────────────────

# Upstash Redis credentials for IP rate limiting (login, PIN, game saves).
# If BOTH are absent the limiters degrade to no-op (fine for local dev, but
# leaves the endpoints unthrottled — always set these in production).
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ── Optional: database migrations ────────────────────────────────────────────

# Direct (unpooled) connection string used for running Prisma migrations.
# On managed Postgres (e.g. Neon) migrations should use the direct endpoint,
# while DATABASE_URL points at the pooled endpoint.
DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host:5432/kidhub?sslmode=require"

# ── Optional: observability ──────────────────────────────────────────────────

# Public Sentry DSN for client-side error/performance reporting.
NEXT_PUBLIC_SENTRY_DSN=""

# Sentry auth token — build-time only, used to upload source maps.
# Kept in apps/web/.env.sentry-build-plugin by default; override here if needed.
SENTRY_AUTH_TOKEN=""

# Sentry org/project — next.config.ts has hardcoded fallbacks; set only to override.
SENTRY_ORG=""
SENTRY_PROJECT=""

# Log level for the Pino logger (lib/logger.ts). Defaults to "info" when unset.
LOG_LEVEL="info"

# ── Optional: end-to-end tests (Playwright) ──────────────────────────────────
# Only needed when running `pnpm test` locally against a seeded parent account.

# Base URL the Playwright suite targets. Defaults to http://localhost:3000.
PLAYWRIGHT_BASE_URL="http://localhost:3000"

# Credentials of the seeded parent account used by e2e auth fixtures.
TEST_PARENT_EMAIL=""
TEST_PARENT_PASSWORD=""
